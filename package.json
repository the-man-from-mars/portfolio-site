{
  "private": true,
  "name": "yahya-rahimi-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio site of Yahya Rahimi, Software Engineer.",
  "author": "Yahya Rahimi",
  "scripts": {
    "build": "react-scripts --openssl-legacy-provider build && node scripts/prerender.mjs",
    "start": "react-scripts --openssl-legacy-provider start",
    "test": "react-scripts test"
  },
  "dependencies": {
    "pdfjs-dist": "^2.12.313",
    "prettier-package-json": "^2.1.3",
    "react": "^16.10.2",
    "react-bootstrap": "^1.0.0-beta.16",
    "react-dom": "^16.10.2",
    "react-pdf": "^5.7.1",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.1.2",
    "react-scripts": "3.2.0",
    "styled-components": "^5.1.1"
  },
  "devDependencies": {
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "2.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier-package-json --write",
    "*.{js,css,md}": "prettier --write"
  }
}
